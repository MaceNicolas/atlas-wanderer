{
 "version": 1,
 "note": "The smallest game: see documentation/mecaniques/jeu-minimal.md.",
 "categories": {
  "servant": {
   "file": "servants",
   "fields": {
    "atk": "int>=0",
    "hp": "int>=1"
   },
   "image": true,
   "label": "Serviteurs"
  },
  "hero": {
   "file": "heroes",
   "fields": {
    "hp": "int>=1"
   },
   "image": true,
   "label": "Héros"
  },
  "dungeon": {
   "file": "dungeons",
   "fields": {
    "boss": "boss"
   },
   "optional": {
    "strategy": "strategy",
    "strategies": "strategies"
   },
   "scene": true,
   "label": "Donjons"
  }
 },
 "state": {
  "zones": {
   "board": {
    "max": "game.maxBoard",
    "layout": "row"
   },
   "hand": {
    "max": "game.handMax",
    "layout": "tray"
   }
  },
  "resources": {
   "room": {
    "start": 1
   }
  },
  "sides": {
   "player": {
    "zones": [
     "board",
     "hand"
    ],
    "resources": [
     "room"
    ]
   },
   "boss": {
    "count": "game.bossBoards",
    "zones": [
     "board",
     "hand"
    ],
    "resources": [],
    "ai": "strategies"
   }
  },
  "vars": {
   "stats": {
    "default": {
     "earned": 0,
     "servants": 0,
     "equips": 0,
     "contrib": 0,
     "fusions": 0,
     "discarded": 0
    },
    "sides": [
     "player",
     "boss"
    ],
    "note": "Counters of the end screen; the resources with a \"stat\" feed them."
   },
   "over": {
    "default": null,
    "sides": [
     "player"
    ]
   },
   "bossCur": {
    "default": -1,
    "sides": [
     "player"
    ]
   },
   "bossLast": {
    "default": -1,
    "sides": [
     "player"
    ]
   },
   "bossLog": {
    "default": [],
    "sides": [
     "player"
    ]
   },
   "flow": {
    "default": null,
    "sides": [
     "player"
    ]
   },
   "spent": {
    "default": {},
    "sides": [
     "player",
     "boss"
    ]
   },
   "owedEquipment": {
    "default": 0,
    "sides": [
     "player",
     "boss"
    ]
   },
   "cues": {
    "default": [],
    "sides": [
     "player"
    ]
   }
  },
  "roles": {
   "note": "The roles that the resources and the zones play for the engine. This game has no money, no reinforcement level and no progress: only the number of the room (turn).",
   "turn": "room",
   "zones": {
    "field": "board",
    "reserve": "hand"
   },
   "sides": {
    "player": "player",
    "opponent": "boss"
   }
  }
 },
 "setup": {
  "steps": [
   {
    "id": "dungeon",
    "pick": {
     "from": "dungeon",
     "count": 1
    },
    "screen": "dungeonSelect",
    "into": "dungeon"
   },
   {
    "id": "heroes",
    "pick": {
     "from": "hero",
     "count": 1,
     "list": true
    },
    "screen": "heroSelect",
    "back": "dungeon",
    "into": "heroes"
   }
  ],
  "init": [
   {
    "action": "setTypes"
   },
   {
    "action": "createSides"
   }
  ]
 },
 "flow": {
  "start": "room",
  "phases": {
   "room": {
    "repeat": true,
    "steps": [
     {
      "id": "bossTurn",
      "auto": true,
      "emit": {
       "enter": "roomStart"
      },
      "run": "bossReinforcement"
     },
     {
      "id": "reinforcement",
      "interactive": true,
      "emit": {
       "enter": "startReinforcement",
       "exit": "endReinforcement"
      },
      "actions": [],
      "effects": [
       {
        "action": "openChoice",
        "choice": "offer",
        "params": {
         "kind": "servant"
        }
       }
      ]
     },
     {
      "id": "combat",
      "auto": true,
      "run": "combat",
      "screen": "playback"
     },
     {
      "id": "settlement",
      "auto": true,
      "run": "settlement"
     },
     {
      "id": "aftermath",
      "auto": true,
      "run": "aftermath",
      "screen": "playback"
     }
    ],
    "end": [
     {
      "if": {
       "query": "bossHp",
       "le": 0
      },
      "go": "victory",
      "effects": [
       {
        "action": "incrementResource",
        "resource": "room"
       }
      ]
     },
     {
      "if": {
       "query": "heroesAlive",
       "le": 0
      },
      "go": "defeat",
      "effects": [
       {
        "action": "incrementResource",
        "resource": "room"
       }
      ]
     },
     {
      "go": "room",
      "effects": [
       {
        "action": "incrementResource",
        "resource": "room"
       }
      ]
     }
    ]
   },
   "victory": {
    "final": true,
    "screen": "endScreen",
    "result": "won"
   },
   "defeat": {
    "final": true,
    "screen": "endScreen",
    "result": "lost"
   }
  }
 },
 "actions": {
  "placeCard": {
   "drag": {
    "from": "hand",
    "to": [
     "board",
     "cardOnBoard"
    ]
   },
   "effects": [
    {
     "action": "placeCard"
    }
   ]
  },
  "discard": {
   "label": "ui.discardCard",
   "icon": "trash",
   "effects": [
    {
     "action": "discardCard"
    }
   ]
  },
  "restart": {
   "label": "ui.newGame",
   "effects": [
    {
     "action": "endGame"
    }
   ]
  }
 },
 "choices": {
  "offer": {
   "from": {
    "draw": "reinforcement",
    "count": "rules.reinforcement.proposals"
   },
   "pick": 1,
   "then": [
    {
     "action": "placeCard",
     "to": "board"
    }
   ],
   "view": "cardRow",
   "title": "ui.chooseCard",
   "modifiers": [],
   "endsStep": true,
   "dragToBoard": true,
   "note": "The offer opens by itself at each reinforcement; the player takes one card (by a click: it goes on the board when there is room, or by dragging it onto the board or onto the servant it replaces) and the reinforcement ends."
  }
 },
 "ui": {
  "theme": {
   "css": "theme.css",
   "title": "ui.gameTitle"
  },
  "animations": {
   "cardPlaced": "pop",
   "resourceGained": "flash",
   "choiceOpened": "slide",
   "cardDiscarded": "shake",
   "levelUp": "flash",
   "statGranted": "lightning",
   "cardCreated": "dropIn"
  },
  "screens": {
   "dungeonSelect": {
    "nodes": [
     {
      "widget": "saveBanner"
     },
     {
      "widget": "modLine"
     },
     {
      "tag": "div",
      "class": "grid gap-3 sm:grid-cols-2 mb-4",
      "children": [
       {
        "widget": "catalogGrid",
        "category": "dungeon",
        "step": "dungeon",
        "act": "selDungeon",
        "next": "toHeroes"
       }
      ]
     }
    ]
   },
   "heroSelect": {
    "nodes": [
     {
      "widget": "subjectFrame",
      "source": "dungeon",
      "class": "flex flex-col sm:flex-row rounded-box cadre overflow-hidden border mb-5",
      "children": [
       {
        "tag": "div",
        "class": "relative sm:w-[42%] shrink-0 min-h-[10rem]",
        "children": [
         {
          "tag": "div",
          "class": "absolute inset-0 [&>svg]:w-full [&>svg]:h-full",
          "children": [
           {
            "widget": "subjectScene",
            "source": "dungeon"
           }
          ]
         },
         {
          "tag": "div",
          "class": "absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black/80 to-transparent",
          "children": [
           {
            "tag": "div",
            "class": "text-2xl font-extrabold text-white",
            "children": [
             {
              "widget": "subjectName",
              "source": "dungeon",
              "field": "card"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "tag": "div",
        "class": "flex-1 p-4 grid gap-3 content-center",
        "children": [
         {
          "tag": "div",
          "class": "flex flex-wrap items-center gap-3",
          "children": [
           {
            "tag": "div",
            "class": "text-2xl font-bold text-error",
            "children": [
             {
              "widget": "subjectName",
              "source": "dungeon",
              "field": "boss"
             }
            ]
           },
           {
            "widget": "subjectHp",
            "source": "dungeon",
            "max": false,
            "iconSize": 16,
            "class": "badge badge-lg badge-error text-black font-black text-base gap-1"
           }
          ]
         },
         {
          "tag": "div",
          "class": "",
          "children": [
           {
            "widget": "subjectType",
            "source": "dungeon"
           }
          ]
         },
         {
          "tag": "div",
          "class": "text-sm",
          "children": [
           {
            "widget": "subjectText",
            "source": "dungeon"
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "tag": "h2",
      "class": "text-xl font-bold text-center mb-3",
      "children": [
       {
        "text": "ui.selectHeroes"
       }
      ]
     },
     {
      "tag": "div",
      "class": "flex flex-wrap justify-center gap-4 mb-6",
      "children": [
       {
        "widget": "catalogGrid",
        "category": "hero",
        "step": "heroes",
        "act": "selHero"
       }
      ]
     },
     {
      "tag": "div",
      "class": "grid grid-cols-[auto_1fr_auto] items-center gap-3",
      "children": [
       {
        "widget": "button",
        "act": "backToDungeon",
        "class": "btn-achat px-6 flex items-center gap-2 font-bold",
        "lead": "‹",
        "label": "ui.back"
       },
       {
        "tag": "div",
        "class": "flex flex-wrap justify-center gap-1.5",
        "children": [
         {
          "widget": "typeChips"
         }
        ]
       },
       {
        "widget": "button",
        "act": "start",
        "class": "btn-achat btn-suite px-8 flex items-center gap-2 font-bold",
        "enabled": "setupComplete",
        "icon": {
         "name": "btnDoor",
         "size": 26,
         "color": "#fdba74"
        },
        "label": "ui.startExploration"
       }
      ]
     }
    ]
   },
   "room": {
    "nodes": [
     {
      "tag": "div",
      "class": "combat flex flex-col min-h-[calc(100dvh-2.5rem)] [--peek:.62]",
      "children": [
       {
        "widget": "subjectFrame",
        "source": "game",
        "marker": "data-boss",
        "class": "flex rounded-box cadre overflow-hidden border",
        "children": [
         {
          "tag": "div",
          "class": "relative w-[28%] shrink-0 min-h-[5.5rem]",
          "children": [
           {
            "tag": "div",
            "class": "absolute inset-0 [&>svg]:w-full [&>svg]:h-full",
            "children": [
             {
              "widget": "subjectScene",
              "source": "game"
             }
            ]
           },
           {
            "tag": "div",
            "class": "absolute inset-x-0 bottom-0 px-2 py-1 bg-gradient-to-t from-black/80 to-transparent",
            "children": [
             {
              "tag": "div",
              "class": "text-sm sm:text-base font-extrabold text-white leading-tight",
              "children": [
               {
                "widget": "subjectName",
                "source": "game",
                "field": "card"
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "tag": "div",
          "class": "flex-1 min-w-0 px-3 py-2 grid gap-1 content-center",
          "children": [
           {
            "tag": "div",
            "class": "flex flex-wrap items-center gap-2",
            "children": [
             {
              "tag": "b",
              "class": "text-error text-lg leading-none",
              "children": [
               {
                "widget": "subjectName",
                "source": "game",
                "field": "boss"
               }
              ]
             },
             {
              "widget": "subjectHp",
              "source": "game",
              "max": true,
              "iconSize": 14,
              "class": "badge badge-error text-black font-black gap-1"
             }
            ]
           },
           {
            "widget": "subjectHpBar",
            "source": "game",
            "class": "progress progress-error w-full h-1.5"
           },
           {
            "tag": "div",
            "class": "flex flex-wrap items-center gap-2",
            "children": [
             {
              "tag": "span",
              "class": "shrink-0",
              "children": [
               {
                "widget": "subjectType",
                "source": "game"
               }
              ]
             },
             {
              "tag": "span",
              "class": "text-xs opacity-80",
              "children": [
               {
                "widget": "subjectText",
                "source": "game"
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "tag": "div",
        "class": "relative flex-1 flex flex-col mt-3 mb-3",
        "children": [
         {
          "tag": "div",
          "class": "plateau-donjon rounded-box p-3 mb-3 flex-1 flex items-center justify-center",
          "children": [
           {
            "widget": "sceneDecor"
           },
           {
            "tag": "div",
            "class": "relative flex flex-wrap justify-center gap-2 min-h-[calc(var(--card-w)*1.65)] w-full",
            "children": [
             {
              "widget": "offerRow"
             }
            ]
           }
          ]
         },
         {
          "tag": "div",
          "class": "plateau rounded-box p-3 flex-1 flex items-center justify-center",
          "children": [
           {
            "tag": "div",
            "class": "flex flex-wrap justify-center gap-2 min-h-[calc(var(--card-w)*1.65)] w-full",
            "children": [
             {
              "widget": "boardRow"
             }
            ],
            "attrs": {
             "data-drop": "board"
            }
           }
          ]
         },
         {
          "widget": "choiceOverlays"
         }
        ]
       },
       {
        "tag": "div",
        "class": "mt-auto",
        "children": [
         {
          "tag": "div",
          "class": "relative flex flex-wrap justify-center gap-3 rounded-box border border-base-content/15 bg-black/25 p-2",
          "children": [
           {
            "widget": "heroSlot",
            "index": 0,
            "interactive": true
           },
           {
            "tag": "div",
            "class": "console-renfort flex-1 min-w-[16rem] flex flex-col justify-between gap-2 p-3 rounded-box",
            "children": [
             {
              "tag": "div",
              "class": "flex gap-2",
              "children": []
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   "playback": {
    "nodes": [
     {
      "tag": "div",
      "class": "combat flex flex-col min-h-[calc(100dvh-2.5rem)] [--peek:.62]",
      "children": [
       {
        "widget": "subjectFrame",
        "source": "game",
        "marker": "data-boss",
        "class": "flex rounded-box cadre overflow-hidden border",
        "children": [
         {
          "tag": "div",
          "class": "relative w-[28%] shrink-0 min-h-[5.5rem]",
          "children": [
           {
            "tag": "div",
            "class": "absolute inset-0 [&>svg]:w-full [&>svg]:h-full",
            "children": [
             {
              "widget": "subjectScene",
              "source": "game"
             }
            ]
           },
           {
            "tag": "div",
            "class": "absolute inset-x-0 bottom-0 px-2 py-1 bg-gradient-to-t from-black/80 to-transparent",
            "children": [
             {
              "tag": "div",
              "class": "text-sm sm:text-base font-extrabold text-white leading-tight",
              "children": [
               {
                "widget": "subjectName",
                "source": "game",
                "field": "card"
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "tag": "div",
          "class": "flex-1 min-w-0 px-3 py-2 grid gap-1 content-center",
          "children": [
           {
            "tag": "div",
            "class": "flex flex-wrap items-center gap-2",
            "children": [
             {
              "tag": "b",
              "class": "text-error text-lg leading-none",
              "children": [
               {
                "widget": "subjectName",
                "source": "game",
                "field": "boss"
               }
              ]
             },
             {
              "widget": "subjectHp",
              "source": "game",
              "max": true,
              "iconSize": 14,
              "class": "badge badge-error text-black font-black gap-1"
             }
            ]
           },
           {
            "widget": "subjectHpBar",
            "source": "game",
            "class": "progress progress-error w-full h-1.5"
           },
           {
            "tag": "div",
            "class": "flex flex-wrap items-center gap-2",
            "children": [
             {
              "tag": "span",
              "class": "shrink-0",
              "children": [
               {
                "widget": "subjectType",
                "source": "game"
               }
              ]
             },
             {
              "tag": "span",
              "class": "text-xs opacity-80",
              "children": [
               {
                "widget": "subjectText",
                "source": "game"
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "tag": "div",
        "class": "relative flex-1 flex flex-col mt-3 mb-3",
        "children": [
         {
          "tag": "div",
          "class": "plateau-donjon rounded-box p-3 mb-3 flex-1 flex items-center justify-center",
          "children": [
           {
            "widget": "sceneDecor"
           },
           {
            "tag": "div",
            "class": "relative flex flex-wrap justify-center gap-2 min-h-[calc(var(--card-w)*1.65)] w-full",
            "children": [
             {
              "widget": "frameRow",
              "side": "boss"
             }
            ]
           }
          ]
         },
         {
          "tag": "div",
          "class": "plateau rounded-box p-3 flex-1 flex items-center justify-center",
          "children": [
           {
            "tag": "div",
            "class": "flex flex-wrap justify-center gap-2 min-h-[calc(var(--card-w)*1.65)] w-full",
            "children": [
             {
              "widget": "frameRow",
              "side": "player"
             }
            ]
           }
          ]
         },
         {
          "widget": "choiceOverlays"
         }
        ]
       },
       {
        "tag": "div",
        "class": "mt-auto",
        "children": [
         {
          "tag": "div",
          "class": "flex flex-wrap justify-center gap-3 rounded-box border border-base-content/15 bg-black/25 p-2",
          "children": [
           {
            "widget": "heroSlot",
            "index": 0,
            "interactive": false
           },
           {
            "tag": "div",
            "class": "console-renfort flex-1 min-w-[16rem] flex flex-col justify-between gap-2 p-3 rounded-box",
            "children": [
             {
              "tag": "div",
              "class": "flex gap-2 min-h-[2.5rem]",
              "children": [
               {
                "widget": "consoleNext",
                "class": "btn-achat btn-suite btn-compact w-full px-3 flex items-center justify-center gap-2 font-bold",
                "act": "next",
                "label": "ui.toReinforcement",
                "endLabel": "ui.seeResult",
                "icon": {
                 "name": "btnReinforce",
                 "size": 22,
                 "color": "#fdba74"
                }
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   "endScreen": {
    "nodes": [
     {
      "tag": "div",
      "class": "hero py-10",
      "children": [
       {
        "tag": "div",
        "class": "hero-content text-center",
        "children": [
         {
          "tag": "div",
          "class": "max-w-md",
          "children": [
           {
            "widget": "endTitle"
           },
           {
            "widget": "endText"
           },
           {
            "tag": "div",
            "class": "stats stats-vertical sm:stats-horizontal shadow mb-4",
            "children": [
             {
              "widget": "stat",
              "label": "ui.statRooms",
              "value": "roomsPlayed"
             },
             {
              "widget": "stat",
              "label": "ui.statBossHp",
              "value": "bossHp"
             }
            ]
           },
           {
            "widget": "endStats"
           },
           {
            "tag": "div",
            "class": "",
            "children": [
             {
              "tag": "button",
              "class": "btn-achat btn-or px-8 font-bold",
              "attrs": {
               "data-act": "restart"
              },
              "children": [
               {
                "text": "ui.newGame"
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  },
  "note": "animations: event -> animation. The engine notes cues (g.cues) when a power asks for one (\"cue\" in the action, or cueAmount/cueUid recorded by a stats action: statGranted); the interface plays the animation that the mod chose for the event.",
  "sounds": {
   "note": "Sounds of the mod: name -> file of the mod (a path under the mod folder, e.g. sounds/hit.ogg). A name with null has no file yet: it is silent. The effects play them with the sound primitive.",
   "attack": null,
   "hit": null,
   "heal": null,
   "buff": null,
   "shield": null,
   "appear": null,
   "death": null
  },
  "effects": [
   {
    "on": "attack",
    "phase": "pre",
    "do": [
     {
      "effect": "lunge"
     },
     {
      "effect": "sound",
      "name": "attack"
     }
    ]
   },
   {
    "on": "damage",
    "do": [
     {
      "effect": "shake",
      "target": "target"
     },
     {
      "effect": "float",
      "target": "target",
      "text": "fx.damage",
      "color": "#ff6b5e"
     },
     {
      "effect": "sound",
      "name": "hit"
     }
    ]
   },
