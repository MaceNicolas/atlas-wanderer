{
 "version": 1,
 "note": "Description of the game of this mod (spec: documentation/mecaniques/flux-de-jeu.md). Steps 1 to 4 of the migration: the sequence of a game (phases, steps, transitions, events, runners) is run from this file by prototype/flow.js, as are the reinforcement purchases; the interface is still drawn by code. \"stat\" / \"gainStat\" are the statistics of the end screen that it counts.",
 "categories": {
  "servant": {
   "file": "servants",
   "fields": {
    "rank": "int>=1",
    "atk": "int>=0",
    "hp": "int>=1",
    "types": "types:one-per-group",
    "sock": "sockets",
    "kw": "keywords",
    "skill": "powers"
   },
   "image": true,
   "label": "Serviteurs"
  },
  "equipment": {
   "file": "equipment",
   "fields": {
    "rank": "int>=1",
    "atk": "int>=0",
    "hp": "int>=0",
    "type": "type",
    "color": "socketColor",
    "kw": "keyword",
    "skill": "powers"
   },
   "image": true,
   "optional": {
    "mod": "summonMod"
   },
   "label": "Équipements"
  },
  "hero": {
   "file": "heroes",
   "fields": {
    "types": "types",
    "hp": "int>=1",
    "kw": "keyword",
    "power": "power"
   },
   "image": true,
   "optional": {
    "reserve": "boolean"
   },
   "label": "Héros"
  },
  "dungeon": {
   "file": "dungeons",
   "fields": {
    "type": "type",
    "minis": "types:two-others",
    "boss": "boss"
   },
   "scene": true,
   "label": "Donjons"
  }
 },
 "state": {
  "zones": {
   "board": {
    "max": "game.maxBoard",
    "layout": "row"
   },
   "hand": {
    "max": "game.handMax",
    "layout": "tray"
   }
  },
  "resources": {
   "datacrons": {
    "start": 0,
    "icon": "datacron",
    "gainStat": "earned",
    "symbol": "◈",
    "title": "ui.datacronsTitle"
   },
   "level": {
    "start": 1,
    "max": "game.maxLevel",
    "icon": "niveauChevrons"
   },
   "levelProgress": {
    "start": 0,
    "stat": "contrib"
   },
   "room": {
    "start": 1
   }
  },
  "sides": {
   "player": {
    "zones": [
     "board",
     "hand"
    ],
    "resources": [
     "datacrons",
     "level",
     "levelProgress",
     "room"
    ]
   },
   "boss": {
    "count": "game.bossBoards",
    "zones": [
     "board",
     "hand"
    ],
    "resources": [
     "datacrons",
     "level",
     "levelProgress"
    ],
    "ai": "bossBehaviors"
   }
  },
  "vars": {
   "stats": {
    "default": {
     "earned": 0,
     "servants": 0,
     "equips": 0,
     "contrib": 0,
     "fusions": 0,
     "discarded": 0
    },
    "sides": [
     "player",
     "boss"
    ],
    "note": "Counters of the end screen; the resources with a \"stat\" feed them."
   },
   "equipOfferLeft": {
    "default": 0,
    "sides": [
     "player"
    ]
   },
   "equipOfferSize": {
    "default": 0,
    "sides": [
     "player"
    ]
   },
   "over": {
    "default": null,
    "sides": [
     "player"
    ]
   },
   "bossCur": {
    "default": -1,
    "sides": [
     "player"
    ]
   },
   "bossLast": {
    "default": -1,
    "sides": [
     "player"
    ]
   },
   "bossLog": {
    "default": [],
    "sides": [
     "player"
    ]
   },
   "flow": {
    "default": null,
    "sides": [
     "player"
    ]
   },
   "companion": {
    "default": null,
    "sides": [
     "player"
    ]
   },
   "spent": {
    "default": {},
    "sides": [
     "player",
     "boss"
    ]
   },
   "promises": {
    "default": [],
    "sides": [
     "player"
    ]
   },
   "bags": {
    "default": {},
    "sides": [
     "player"
    ]
   },
   "lastDraw": {
    "default": null,
    "sides": [
     "player"
    ]
   },
   "summonBonus": {
    "default": {},
    "sides": [
     "player",
     "boss"
    ]
   },
   "owedEquipment": {
    "default": 0,
    "sides": [
     "player",
     "boss"
    ]
   },
   "cues": {
    "default": [],
    "sides": [
     "player"
    ]
   }
  },
  "roles": {
   "note": "The roles that the resources and the zones play for the engine (zones: field = where the cards fight, reserve = where they wait): money = what purchases cost; level = the reinforcement level; progress = the progress toward the next level; turn = the number of the room. A mod names its resources as it likes and says here which one plays each role.",
   "money": "datacrons",
   "level": "level",
   "progress": "levelProgress",
   "turn": "room",
   "triggers": {
    "note": "Names of the moments when the engine fires the powers of the cards (role: name used by `t`).",
    "deathrattle": "deathrattle",
    "allyDeath": "allyDeath",
    "enemyDeath": "enemyDeath",
    "startCombat": "startCombat",
    "space": "space",
    "assault": "assault",
    "afterDamage": "afterDamage",
    "attackNoKill": "attackNoKill",
    "attackSurvive": "attackSurvive",
    "survive": "survive",
    "battlecry": "battlecry",
    "startReinforcement": "startReinforcement",
    "endReinforcement": "endReinforcement",
    "active": "active",
    "passive": "passive"
   },
   "zones": {
    "field": "board",
    "reserve": "hand"
   },
   "sides": {
    "player": "player",
    "opponent": "boss"
   }
  }
 },
 "setup": {
  "steps": [
   {
    "id": "dungeon",
    "pick": {
     "from": "dungeon",
     "count": 1
    },
    "screen": "dungeonSelect",
    "into": "dungeon"
   },
   {
    "id": "heroes",
    "pick": {
     "from": "hero",
     "count": 2
    },
    "screen": "heroSelect",
    "back": "dungeon",
    "into": "heroes"
   }
  ],
  "init": [
   {
    "action": "setTypes"
   },
   {
    "action": "createSides"
   }
  ]
 },
 "flow": {
  "start": "room",
  "phases": {
   "room": {
    "repeat": true,
    "steps": [
     {
      "id": "bossTurn",
      "auto": true,
      "emit": {
       "enter": "roomStart"
      },
      "run": "bossReinforcement"
     },
     {
      "id": "startMission",
      "auto": true,
      "when": [
       {
        "query": "room",
        "eq": 1
       }
      ],
      "emit": {
       "enter": "startMission"
      }
     },
     {
      "id": "income",
      "auto": true,
      "emit": {
       "enter": "beforeIncome"
      },
      "effects": [
       {
        "action": "gainResource",
        "resource": "datacrons",
        "amount": {
         "table": "game.income",
         "index": "room"
        },
        "log": "log.income"
       }
      ]
     },
     {
      "id": "reinforcement",
      "interactive": true,
      "emit": {
       "enter": "startReinforcement",
       "exit": "endReinforcement"
      },
      "actions": [
       "buyServant",
       "buyEquipment",
       "buyLevel",
       "placeCard",
       "discard",
       "usePower",
       "finish"
      ],
      "until": "finish"
     },
     {
      "id": "combat",
      "auto": true,
      "run": "combat",
      "screen": "playback"
     },
     {
      "id": "settlement",
      "auto": true,
      "run": "settlement"
     },
     {
      "id": "aftermath",
      "auto": true,
      "run": "aftermath",
      "screen": "playback"
     }
    ],
    "end": [
     {
      "if": {
       "query": "bossHp",
       "le": 0
      },
      "go": "victory",
      "effects": [
       {
        "action": "incrementResource",
        "resource": "room"
       }
      ]
     },
     {
      "if": {
       "query": "heroesAlive",
       "le": 0
      },
      "go": "defeat",
      "effects": [
       {
        "action": "incrementResource",
        "resource": "room"
       }
      ]
     },
     {
      "go": "room",
      "effects": [
       {
        "action": "incrementResource",
        "resource": "room"
       }
      ]
     }
    ]
   },
   "victory": {
    "final": true,
    "screen": "endScreen",
    "result": "won"
   },
   "defeat": {
    "final": true,
    "screen": "endScreen",
    "result": "lost"
   }
  }
 },
 "actions": {
  "buyServant": {
   "label": "ui.reinforceServant",
   "icon": "btnServant",
   "cost": {
    "datacrons": "rules.reinforcement.kinds.servant.cost"
   },
   "when": [
    {
     "not": {
      "zone": "hand",
      "is": "full"
     }
    },
    {
     "not": {
      "choiceOpen": "other"
     }
    }
   ],
   "effects": [
    {
     "action": "openChoice",
     "choice": "offer",
     "params": {
      "kind": "servant"
     }
    }
   ]
  },
  "buyEquipment": {
   "label": "ui.reinforceEquipment",
   "icon": "equip",
   "cost": {
    "datacrons": "rules.reinforcement.kinds.equip.cost"
   },
   "when": [
    {
     "not": {
      "zone": "hand",
      "is": "full"
     }
    },
    {
     "not": {
      "choiceOpen": "other"
     }
    }
   ],
   "effects": [
    {
     "action": "openChoice",
     "choice": "offer",
     "params": {
      "kind": "equip"
     }
    }
   ]
  },
  "buyLevel": {
   "label": "ui.level",
   "icon": "niveauChevrons",
   "cost": {
    "datacrons": 1
   },
   "when": [
    {
     "resource": "level",
     "lt": "game.maxLevel"
    },
    {
     "not": {
      "choiceOpen": "any"
     }
    }
   ],
   "effects": [
    {
     "action": "incrementResource",
     "resource": "levelProgress"
    },
    {
     "action": "levelUpIfFull"
    }
   ],
   "labelAtMax": {
    "resource": "level",
    "text": "ui.levelMaxShort"
   },
   "iconColor": "#B9A8FF"
  },
  "placeCard": {
   "drag": {
    "from": "hand",
    "to": [
     "board",
     "cardOnBoard"
    ]
   },
   "effects": [
    {
     "action": "placeCard"
    }
   ]
  },
  "discard": {
   "label": "ui.discardCard",
   "icon": "trash",
   "effects": [
    {
     "action": "discardCard"
    }
   ]
  },
  "usePower": {
   "effects": [
    {
     "action": "usePower"
    }
   ]
  },
  "finish": {
   "label": "ui.exploreNextRoom",
   "icon": "btnDoor",
   "when": [],
   "effects": [
    {
     "action": "endStep"
    }
   ],
   "offerWhen": [
    {
     "any": [
      {
       "resource": "datacrons",
       "lt": 1
      },
      {
       "all": [
        {
         "resource": "level",
         "ge": "game.maxLevel"
        },
        {
         "zone": "hand",
         "is": "full"
        }
       ]
      }
     ]
    }
   ]
  },
  "restart": {
   "label": "ui.newGame",
   "effects": [
    {
     "action": "endGame"
    }
   ]
  }
 },
 "choices": {
  "offer": {
   "from": {
    "draw": "reinforcement",
    "count": "rules.reinforcement.proposals"
   },
   "pick": 1,
   "abandon": true,
   "then": [
    {
     "action": "moveCard",
     "to": "hand"
    }
   ],
   "view": "cardRow",
   "title": "ui.chooseCard",
   "modifiers": [
    {
     "power": "firstOfferUp",
     "effect": "upgradeFirstOffer"
    },
    {
     "power": "firstEquipOffType",
     "effect": "offTypeChance",
     "kind": "equip",
     "percentPer": "n"
    }
   ],
   "note": "modifiers: powers carried by servants on the board that change the offers. upgradeFirstOffer: one card of the first offer of the reinforcement is replaced by a card of the next rank (it does not stack). offTypeChance: the first card of an offer of the given kind has a chance (the \"percentPer\" field of the power, in percent, added up for all carriers) to be of a type absent from the team."
  },
  "fusionReward": {
   "from": {
    "draw": "rank",
    "count": "game.fusionRewardProposals"
   },
   "pick": 1,
   "then": [
    {
     "action": "moveCard",
     "to": "hand"
    }
   ],
   "view": "cardRow",
   "title": "ui.rewardFusion",
   "subtitle": "ui.joinsYourHand",
   "cards": "servantTemplate"
  },
  "adaptation": {
   "note": "After a combat, each surviving servant that has the power \"who.power\" (and the type \"who.type\") chooses among its options. \"extraPower\": a servant with this power gets one more choice per copy (it will not be offered again what the previous choice offered). \"learnExcludes\": powers that cannot be learned from another servant.",
   "per": "survivor",
   "who": {
    "power": "adapt",
    "type": "elk"
   },
   "extraPower": "adaptExtra",
   "learnExcludes": {
    "powers": [
     "adapt",
     "adaptExtra"
    ],
    "triggers": [
     "battlecry"
    ]
   },
   "options": [
    {
     "kind": "statBoost",
     "amount": {
      "resource": "level"
     },
     "stats": [
      "hp",
      "atk"
     ]
    },
    {
     "kind": "borrowPower",
     "from": "otherSurvivors"
    }
   ],
   "from": {
    "draw": "options"
   },
   "pick": 1,
   "then": [
    {
     "action": "power"
    }
   ],
   "view": "optionList",
   "title": "ui.adaptation"
  },
  "discoverEquipment": {
   "from": {
    "draw": "queued"
   },
   "pick": 1,
   "then": [
    {
     "action": "moveCard",
     "to": "hand"
    }
   ],
   "view": "cardRow",
   "title": "ui.rewardEquip",
   "subtitle": "ui.joinsYourHand",
   "cards": "equipment"
  },
  "chooseAlly": {
   "from": {
    "draw": "queued"
   },
   "pick": 1,
   "then": [
    {
     "action": "gainStat",
     "stat": "atk"
    }
   ],
   "view": "cardRow",
   "title": "ui.rewardAlly",
   "subtitle": "ui.bonusPermanent",
   "cards": "servantOnBoard"
  }
 },
 "ui": {
  "theme": {
   "css": "theme.css",
   "title": "ui.gameTitle"
  },
  "animations": {
   "cardPlaced": "pop",
   "resourceGained": "flash",
   "choiceOpened": "slide",
   "cardDiscarded": "shake",
   "levelUp": "flash",
   "statGranted": "lightning",
   "cardCreated": "dropIn"
  },
  "screens": {
