       4,
       5,
       6
      ],
      "weights": [
       6,
       5,
       4,
       3,
       2,
       1
      ]
     }
    },
    "atk": "$x",
    "hp": "$x",
    "record": {
     "cueAmount": "$x",
     "cueUid": {
      "stat": "uid",
      "of": "target"
     }
    },
    "log": "log.cyberPatch"
   }
  ]
 },
 "boostCompanion": {
