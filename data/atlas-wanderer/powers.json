{
 "changeStats": {
  "params": [
   "target",
   "permanent",
   "scale"
  ],
  "vars": {
   "times": "$scale"
  },
  "then": [
   {
    "action": "stats",
    "target": "$target",
    "atk": {
     "mul": [
      "$a",
      "$times"
     ]
    },
    "hp": {
     "mul": [
      "$h",
      "$times"
     ]
    },
    "if": "$times",
    "permanent": "$permanent",
    "log": "log.changeStats"
   }
  ]
 },
 "reduceAtk": {
  "params": [
   "target",
   "quantity"
  ],
  "then": [
   {
    "action": "stats",
    "target": "$target",
    "atk": {
     "mul": [
      "$quantity",
      -1
     ]
    },
    "floorAtk": true,
    "log": "log.reduceAtk"
   }
  ]
 },
 "reduceTargetAtkBeforeAttack": {
  "reactions": [
   {
    "on": "beforeAttack",
    "then": [
     {
      "action": "stats",
      "target": {
       "ref": "target"
      },
      "atk": {
       "mul": [
        "$n",
        -1
       ]
      },
      "floorAtk": true,
      "hl": {
       "att": "carrier",
       "tgt": "target"
      },
      "log": "log.reduceAtk"
     }
    ]
   }
  ]
 },
 "doubleLowestHp": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "pick": "min:hp"
    },
    "hp": {
     "stat": "hp",
     "of": "target"
    },
    "log": "log.doubleHp"
   }
  ]
 },
 "doubleLeftmostHp": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "pick": "leftmost"
    },
    "hp": {
     "stat": "hp",
     "of": "target"
    },
    "flag": "voronoi",
    "log": "log.doubleHp"
   }
  ]
 },
 "giveShield": {
  "params": [
   "target"
  ],
  "then": [
   {
    "action": "shield",
    "target": "$target",
    "log": "log.shieldTo"
   }
  ]
 },
 "shieldSelfOnce": {
  "then": [
   {
    "action": "shield",
    "target": {
     "side": "self"
    },
    "once": "egideUsed",
    "log": "log.shieldSelf"
   }
  ]
 },
 "stripShield": {
  "then": [
   {
    "action": "removeShield",
    "target": {
     "side": "enemy",
     "pick": "random",
     "hasShield": true
    },
    "log": "log.stripShield"
   }
  ]
 },
 "removeKeyword": {
  "params": [
   "keyword",
   "target"
  ],
  "then": [
   {
    "action": "keyword",
    "target": "$target",
    "remove": "$keyword",
    "log": "log.removeKeyword"
   }
  ]
 },
 "giveKeyword": {
  "params": [
   "keyword",
   "target"
  ],
  "then": [
   {
    "action": "keyword",
    "target": "$target",
    "give": "$keyword",
    "join": " et ",
    "log": "log.giveKeyword"
   }
  ]
 },
 "muteRiposte": {
  "then": [
   {
    "action": "flag",
    "target": {
     "side": "enemy",
     "pick": "max:atk"
    },
    "flag": "noRiposte",
    "log": "log.muteRiposte"
   }
  ]
 },
 "pacify": {
  "then": [
   {
    "action": "flag",
    "target": {
     "side": "enemy",
     "pick": "max:atk"
    },
    "flag": "noAtk",
    "log": "log.pacify"
   }
  ]
 },
 "swapStatsMostHp": {
  "then": [
   {
    "action": "swapAtkHp",
    "target": {
     "side": "enemy",
     "pick": "max:hp"
    },
    "log": "log.swapStatsMostHp"
   }
  ]
 },
 "hpRightmostTo1": {
  "then": [
   {
    "action": "set",
    "target": {
     "side": "enemy",
     "pick": "rightmost"
    },
    "fields": {
     "hp": {
      "min": [
       {
        "stat": "hp",
        "of": "target"
       },
       1
      ]
     }
    },
    "log": "log.hpRightmostTo1"
   }
  ]
 },
 "gainHighestHp": {
  "vars": {
   "x": {
    "maxOf": "hp",
    "over": {
     "side": "ally",
     "exclude": "carrier"
    }
   }
  },
  "then": [
   {
    "if": {
     "count": {
      "side": "ally",
      "exclude": "carrier"
     }
    },
    "action": "set",
    "target": {
     "side": "self"
    },
    "fields": {
     "hp": "$x",
     "maxhp": "$x"
    },
    "log": "log.gainHighestHp"
   }
  ]
 },
 "copyHighestAtk": {
  "vars": {
   "x": {
    "maxOf": "atk",
    "over": {
     "side": "ally",
     "exclude": "carrier"
    }
   }
  },
  "then": [
   {
    "if": {
     "count": {
      "side": "ally",
      "exclude": "carrier"
     }
    },
    "action": "set",
    "target": {
     "side": "self"
    },
    "fields": {
     "atk": "$x"
    },
    "log": "log.copyHighestAtk"
   }
  ]
 },
 "swapHpLeftmost": {
  "then": [
   {
    "action": "swapHp",
    "first": {
     "side": "self"
    },
    "second": {
     "side": "enemy",
     "pick": "leftmost"
    },
    "log": "log.swapHpLeftmost"
   }
  ]
 },
 "swapHpExtremes": {
  "vars": {
   "lo": {
    "minOf": "hp",
    "over": {
     "side": "enemy"
    }
   },
   "hi": {
    "maxOf": "hp",
    "over": {
     "side": "enemy"
    }
   }
  },
  "then": [
   {
    "if": {
     "all": [
      {
       "gte": [
        {
         "count": {
          "side": "enemy"
         }
        },
        2
       ]
      },
      {
       "gte": [
        {
         "add": [
          "$hi",
          {
           "mul": [
            -1,
            "$lo"
           ]
          }
         ]
        },
        1
       ]
      }
     ]
    },
    "action": "swapHp",
    "first": {
     "side": "enemy",
     "pick": "min:hp"
    },
    "second": {
     "side": "enemy",
     "pick": "max:hp"
    },
    "log": "log.swapHpExtremes"
   }
  ]
 },
 "balanceLeftHp": {
  "then": [
   {
    "action": "balance",
    "with": {
     "side": "ally",
     "pick": "leftNeighbor"
    },
    "log": "log.balanceLeftHp"
   }
  ]
 },
 "trade": {
  "vars": {
   "lost": {
    "min": [
     "$n",
     {
      "stat": "atk",
      "of": "carrier"
     }
    ]
   }
  },
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "self"
    },
    "atk": {
     "mul": [
      -1,
      "$lost"
     ]
    },
    "hp": "$h",
    "log": "log.trade"
   }
  ]
 },
 "heal": {
  "params": [
   "target",
   "quantity"
  ],
  "then": [
   {
    "action": "heal",
    "target": "$target",
    "amount": {
     "add": [
      "$quantity",
      {
       "stat": "healBonus",
       "of": "carrier"
      }
     ]
    },
    "skipZero": true,
    "log": "log.heal",
    "woundedOnly": true,
    "logMany": "log.healMany"
   }
  ]
 },
 "dealDamage": {
  "params": [
   "target",
   "attributed",
   "quantity"
  ],
  "then": [
   {
    "action": "damage",
    "target": "$target",
    "amount": "$quantity",
    "source": "$attributed",
    "skipZero": true,
    "hl": {
     "att": "carrier",
     "tgt": "target"
    },
    "log": "log.dmg"
   }
  ]
 },
 "discordApple": {
  "then": [
   {
    "if": {
     "gte": [
      {
       "count": {
        "side": "enemy"
       }
      },
      2
