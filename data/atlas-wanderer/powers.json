 },
 "doubleFirstAttack": {
  "reactions": [
   {
    "on": "attackDamage",
    "if": {
     "lt": [
      {
       "stat": "firstAttackDone",
       "of": "carrier"
      },
      1
     ]
    },
    "then": [
     {
      "action": "modify",
