 "lazarusOfToken": {
  "params": [
   "token"
  ],
  "reactions": [
   {
    "on": "deathLazarus",
    "if": {
     "all": [
      {
       "not": {
        "all": [
         {
          "evtHas": "res"
         },
         {
          "lt": [
           {
            "boardSize": 1
           },
           {
            "maxBoard": 1
           }
          ]
         }
        ]
       }
      },
      {
       "not": {
        "stat": "reb",
        "of": "dead"
       }
      },
      {
       "not": {
        "stat": "companion",
        "of": "dead"
       }
      },
      {
       "not": {
        "tokenIs": "$token",
        "of": "dead"
       }
      }
     ]
    },
    "then": [
     {
      "action": "claim",
      "field": "lazare"
     },
