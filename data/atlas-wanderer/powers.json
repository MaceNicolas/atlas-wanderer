     "gte": [
      {
       "count": {
        "side": "enemy"
       }
      },
      2
     ]
    },
    "action": "damage",
    "target": {
     "side": "enemy",
     "pick": "random",
     "exclude": "@a"
    },
    "amount": {
     "stat": "atk",
     "of": "@a"
    },
    "source": "@a",
    "log": "log.discordApple"
   }
  ]
 },
 "cyberPatch": {
