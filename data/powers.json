 "buffPerType": {
  "vars": {
   "n": {
    "min": [
     3,
     {
      "distinctTypes": {
       "side": "ally"
      }
     }
    ]
   }
  },
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "self"
    },
    "atk": {
     "mul": [
      "$a",
      "$n"
     ]
    },
    "hp": {
     "mul": [
      "$h",
      "$n"
     ]
    },
    "if": "$n",
    "log": "log.buffPerType"
   }
  ]
 },
