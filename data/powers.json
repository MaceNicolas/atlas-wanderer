{
 "buffSelf": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "self"
    },
    "atk": "$a",
    "hp": "$h",
    "log": "log.buffSelf"
   }
  ]
 },
 "buffAllies": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "exclude": "carrier"
    },
    "atk": "$a",
    "hp": "$h",
    "log": "log.buffAllies"
   }
  ]
 },
 "buffRandomAlly": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "exclude": "carrier",
     "pick": "random",
     "fallback": {
      "side": "ally",
      "pick": "random"
     }
    },
    "atk": "$a",
    "hp": "$h",
    "log": "log.buffTo"
   }
  ]
 },
 "buffAllAllies": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally"
    },
    "atk": "$a",
    "hp": "$h",
    "log": "log.buffAllAllies"
   }
  ]
 },
 "buffLeftmost": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "pick": "leftmost"
    },
    "atk": "$a",
    "hp": "$h",
    "log": "log.buffTo"
   }
  ]
 },
 "buffRightmost": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "pick": "rightmost"
    },
    "atk": "$a",
    "hp": "$h",
    "log": "log.buffTo"
   }
  ]
 },
 "buffEnds": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "pick": "ends"
    },
    "atk": "$a",
    "hp": "$h",
    "join": " et ",
    "log": "log.buffToList"
   }
  ]
 },
 "buffAdjacent": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "pick": "neighbors"
    },
    "atk": "$a",
    "hp": "$h",
    "join": " et ",
    "log": "log.buffToList"
   }
  ]
 },
 "buffPilots": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "exclude": "carrier",
     "type": "pilot"
    },
    "atk": "$a",
    "hp": "$h",
    "log": "log.buffPilots"
   }
  ]
 },
 "buffEquippedAlly": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "exclude": "carrier",
     "equipped": true,
     "pick": "random"
    },
    "atk": "$a",
    "hp": "$h",
    "log": "log.buffEquippedAlly"
   }
  ]
 },
 "buffPerType": {
  "vars": {
   "n": {
    "min": [
     3,
     {
      "distinctTypes": {
       "side": "ally"
      }
     }
    ]
   }
  },
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "self"
    },
    "atk": {
     "mul": [
      "$a",
      "$n"
     ]
    },
    "hp": {
     "mul": [
      "$h",
      "$n"
     ]
    },
    "if": "$n",
    "log": "log.buffPerType"
   }
  ]
 },
 "buffPerTypeUncapped": {
  "vars": {
   "n": {
    "distinctTypes": {
     "side": "ally"
    }
   }
  },
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "self"
    },
    "atk": {
     "mul": [
      "$a",
      "$n"
     ]
    },
    "hp": {
     "mul": [
      "$h",
      "$n"
     ]
    },
    "if": "$n",
    "log": "log.buffPerType"
   }
  ]
 },
 "buffPerEnemyType": {
  "vars": {
