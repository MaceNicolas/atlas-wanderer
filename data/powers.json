 "buffPerEquip": {
  "vars": {
   "x": {
    "sumEquips": {
     "side": "ally"
    }
   }
  },
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "self"
    },
    "atk": {
     "mul": [
      "$a",
      "$x"
     ]
    },
    "hp": {
     "mul": [
      "$h",
      "$x"
     ]
    },
    "if": "$x",
    "log": "log.buffPerEquip"
   }
  ]
 },
 "debuffRandomEnemy": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "enemy",
     "pick": "random"
    },
    "atk": {
     "mul": [
      "$n",
      -1
     ]
    },
    "floorAtk": true,
    "log": "log.debuff"
   }
  ]
 },
 "debuffLeftmost": {
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "enemy",
     "pick": "leftmost"
    },
    "atk": {
     "mul": [
      "$n",
      -1
     ]
    },
    "floorAtk": true,
    "log": "log.debuff"
   }
  ]
 },
 "debuffByLevel": {
  "vars": {
   "n": {
    "level": 1
   }
  },
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "enemy",
     "pick": "random"
    },
    "atk": {
     "mul": [
      "$n",
      -1
     ]
    },
    "floorAtk": true,
