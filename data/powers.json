 "gainHighestHp": {
  "vars": {
   "x": {
    "maxOf": "hp",
    "over": {
     "side": "ally",
     "exclude": "carrier"
    }
   }
  },
  "then": [
   {
    "if": {
     "count": {
      "side": "ally",
      "exclude": "carrier"
     }
    },
    "action": "set",
    "target": {
     "side": "self"
    },
    "fields": {
     "hp": "$x",
     "maxhp": "$x"
    },
    "log": "log.gainHighestHp"
   }
  ]
 },
