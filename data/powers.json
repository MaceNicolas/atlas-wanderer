 "swapHpLeftmost": {
  "then": [
   {
    "action": "swapHp",
    "first": {
     "side": "self"
    },
    "second": {
     "side": "enemy",
     "pick": "leftmost"
    },
    "log": "log.swapHpLeftmost"
   }
  ]
 },
 "swapHpExtremes": {
  "vars": {
   "lo": {
    "minOf": "hp",
    "over": {
     "side": "enemy"
    }
   },
   "hi": {
    "maxOf": "hp",
    "over": {
     "side": "enemy"
    }
   }
  },
  "then": [
   {
    "if": {
     "all": [
      {
       "gte": [
        {
         "count": {
          "side": "enemy"
         }
        },
        2
       ]
      },
      {
       "gte": [
        {
         "add": [
          "$hi",
          {
           "mul": [
            -1,
            "$lo"
           ]
          }
         ]
        },
        1
       ]
      }
     ]
    },
    "action": "swapHp",
    "first": {
     "side": "enemy",
     "pick": "min:hp"
    },
    "second": {
     "side": "enemy",
     "pick": "max:hp"
    },
    "log": "log.swapHpExtremes"
   }
  ]
 },
