 "buffAdjacentPerType": {
  "vars": {
   "n": {
    "distinctTypes": {
     "side": "ally"
    }
   }
  },
  "then": [
   {
    "action": "stats",
    "target": {
     "side": "ally",
     "pick": "neighbors"
    },
