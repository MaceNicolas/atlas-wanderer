#!/bin/sh
# Captures de screens_history/ : nettoyage des métadonnées, webp, renommage horodaté, puis ajout au commit.
# Activé par : git config core.hooksPath .githooks
racine=$(git rev-parse --show-toplevel)
cd "$racine" || exit 1
if [ -d screens_history ]; then
  python3 tools/screens-history.py || { echo "pre-commit : échec du traitement de screens_history" >&2; exit 1; }
  git add -A screens_history
fi
exit 0
